{
  "name": "nuthouse",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "build:runtime": "cp _shared/runtime/src/claude.mjs linear-devotee/claudecode/lib/runtime.mjs",
    "check:runtime": "diff -q _shared/runtime/src/claude.mjs linear-devotee/claudecode/lib/runtime.mjs",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test:runtime": "bun test _shared/runtime/tests/claude.test.mjs",
    "test:meta": "cd .claude/tests && bun test",
    "bump:shas": "node scripts/bump-marketplace-shas.mjs",
    "bump:versions": "node scripts/bump-plugin-versions.mjs",
    "sync:codex-agents": "node scripts/sync-codex-agents.mjs",
    "plan:codex-agents": "node scripts/sync-codex-agents.mjs --install --dry-run",
    "install:codex-agents": "node scripts/sync-codex-agents.mjs --install",
    "check:codex-agents": "node scripts/sync-codex-agents.mjs --check",
    "check:installed-codex-agents": "node scripts/sync-codex-agents.mjs --install --check",
    "check:workflow": "node scripts/check-plugin-invariants.mjs",
    "test:scripts": "bun test scripts/tests",
    "check:duplication": "node scripts/check-prose-duplication.mjs"
  },
  "devDependencies": {
    "lefthook": "2.1.8",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.64.0"
  },
  "packageManager": "bun@1.3.13"
}
