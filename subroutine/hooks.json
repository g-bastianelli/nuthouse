{
  "subroutine": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./claudecode/hooks/antigravity-hook.mjs SessionStart ./claudecode/hooks/inject-digest.mjs"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ./claudecode/hooks/antigravity-hook.mjs PostToolUse ./claudecode/hooks/inject-on-edit.mjs"
          }
        ]
      }
    ],
    "PreInvocation": [
      { "type": "command", "command": "node ./claudecode/hooks/antigravity-hook.mjs PreInvocation" }
    ]
  }
}
